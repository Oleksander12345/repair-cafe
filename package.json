{
  "name": "repair-cafe",
  "version": "0.1.0",
  "description": "Черга ремонтів для Repair Café (курсовий проєкт, Node.js)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "test:smoke": "node --import tsx --test test/smoke.test.ts",
    "test:scenarios": "node --import tsx --test --test-concurrency=1 test/scenarios.test.ts test/concurrency.test.ts test/retry.test.ts test/pg-fixture-safety.test.ts test/service-regressions.test.ts",
    "test:db": "node --import tsx test/run-postgres.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run deps:check && npm run test:smoke && npm run test:scenarios && npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "prettier --write",
      "eslint --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
